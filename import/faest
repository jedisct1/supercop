#!/bin/sh

supercop=.
reftop=import/faest-ref
opttop=import/faest-arch-opt
tablestop=import/faest-tables
firstparams=$supercop/crypto_sign/faest128fv3/ref/parameters.h

for p in 128f 128s 192f 192s 256f 256s em128f em128s em192f em192s em256f em256s
do
  targettop="$supercop/crypto_sign/faest${p}v3"
  rm -rf "$targettop"
  mkdir -p "$targettop"

  underp=`echo $p | sed s/em/em_/`
  paramp=param_$underp
  param=`sed -n s/$paramp'\.set('\''PARAM'\'', '\''\(.*\)'\'')/\1/p' < "$reftop"/meson.build`
  paraml=`sed -n s/$paramp'\.set('\''PARAM_L'\'', '\''\(.*\)'\'')/\1/p' < "$reftop"/meson.build`
  skbytes=`sed -n s/$paramp'\.set('\''SK_SIZE'\'', \(.*\))/\1/p' < "$reftop"/meson.build`
  pkbytes=`sed -n s/$paramp'\.set('\''PK_SIZE'\'', \(.*\))/\1/p' < "$reftop"/meson.build`
  sigbytes=`sed -n s/$paramp'\.set('\''SIG_SIZE'\'', \(.*\))/\1/p' < "$reftop"/meson.build`
  owfinput=`sed -n s/$paramp'\.set('\''OWF_INPUT_SIZE'\'', \(.*\))/\1/p' < "$reftop"/meson.build`
  owfoutput=`sed -n s/$paramp'\.set('\''OWF_OUTPUT_SIZE'\'', \(.*\))/\1/p' < "$reftop"/meson.build`
  lambda=`sed -n s/$paramp'\.set('\''LAMBDA'\'', \(.*\))/\1/p' < "$reftop"/meson.build`
  ell=`sed -n s/$paramp'\.set('\''ELL'\'', \(.*\))/\1/p' < "$reftop"/meson.build`

  (
    echo ref "$reftop"
    echo avx2 "$opttop"
    echo aarch64 "$opttop"
  ) |
  while read target source
  do

    x="$targettop/$target"
    mkdir -p "$x"
    echo "integrating $x..."

    case $target in
      ref)
        cp -pr "$source"/*.c "$x"
        cp -pr "$source"/*.h "$x"
        sed -i 's/#define HAVE_MEMPCPY/#undef HAVE_MEMPCPY/' "$x"/compat.h
        (
          echo "$source"/faest_param.h.in "$x"/faest_$underp.h
          echo "$source"/faest_param.c.in "$x"/faest_$underp.c
          echo "$source"/faest_aes.c.in "$x"/faest_aes_128.c 128
          echo "$source"/faest_aes.c.in "$x"/faest_aes_192.c 192
          echo "$source"/faest_aes.c.in "$x"/faest_aes_256.c 256
          echo "$source"/crypto_sign.c.in "$x"/crypto_sign.c
        ) | while read input output bits
        do
          sed \
          -e s/@SK_SIZE@/$skbytes/g \
          -e s/@PK_SIZE@/$pkbytes/g \
          -e s/@SIG_SIZE@/$sigbytes/g \
          -e s/@PARAM@/$param/g \
          -e s/@PARAM_L@/$paraml/g \
          -e s/@OWF_INPUT_SIZE@/$owfinput/g \
          -e s/@OWF_OUTPUT_SIZE@/$owfoutput/g \
          -e s/@LAMBDA@/$lambda/g \
          -e s/@ELL@/$ell/g \
          -e s/@SSS@/$bits/g \
          < "$input" > "$output"
        done
        cp "$tablestop"/*.h "$x"

        if [ -f $firstparams ]
        then
          cp "$firstparams" "$x"/parameters.h
        else
          [ "$firstparams" = "$x"/parameters.h ] || echo oops, firstparams out of order
          (
            echo '#pragma once'

            for q in 128f 128s 192f 192s 256f 256s em128f em128s em192f em192s em256f em256s
            do
              underq=`echo $q | sed s/em/em_/`
              paramq=param_$underq
              zparam=`sed -n s/$paramq'\.set('\''PARAM'\'', '\''\(.*\)'\'')/\1/p' < "$reftop"/meson.build`
              for x in BETA ELL LAMBDA Lenc Lke N_MULT Nst OWF_INPUT_SIZE OWF_OUTPUT_SIZE PARAM PARAM_L PK_SIZE R SIG_SIZE SK_SIZE Ske TAU T_OPEN W_GRIND
              do
                y=`sed -n s/$paramq'\.set('\'$x\'', \(.*\))/\1/p' < "$reftop"/meson.build`
                echo ''
                echo "#define FAEST_${zparam}_$x $y"
              done
            done
      
            echo '#define FAEST_128_LAMBDA 128'
            echo '#define FAEST_192_LAMBDA 192'
            echo '#define FAEST_256_LAMBDA 256'
          ) > "$x"/parameters.h
        fi
      ;;

      *)
        cp -pr "$source"/*.c "$x"
        cp -pr "$source"/*.h "$x"
        cp -pr "$source"/*.cpp "$x"
        cp -pr "$source"/*.hpp "$x"
        cp -pr "$source"/*.inc "$x"
        cp -pr "$source"/common/*.inc "$x"
        cp -pr "$source"/sha3/*.c "$x"
        cp -pr "$source"/sha3/*.h "$x"
        cp -pr "$source"/sha3/*.inc "$x"
        cp -pr "$source"/"$target"/*.cpp "$x"
        cp -pr "$source"/"$target"/*.hpp "$x"
        cp "$tablestop"/*.hpp "$x"
        cp "$tablestop"/*.cpp "$x"

        sed -i 's_align\.h_libkeccak.a.headers/align.h_' "$x"/KeccakSponge-times4.h
        sed -i 's_config\.h_libkeccak.a.headers/config.h_' "$x"/KeccakHash-times4.h
        sed -i 's_config\.h_libkeccak.a.headers/config.h_' "$x"/KeccakSponge-times4.h
        sed -i 's_KeccakHash\.h_libkeccak.a.headers/KeccakHash.h_' "$x"/KeccakHash-times4.h
        sed -i 's_KeccakHash\.h_libkeccak.a.headers/KeccakHash.h_' "$x"/hash.hpp
        sed -i 's_KeccakP-1600-times4-SnP\.h_libkeccak.a.headers/KeccakP-1600-times4-SnP.h_' "$x"/KeccakSponge-times4.h
        sed -i 's_KeccakP-1600-times4-SnP\.h_libkeccak.a.headers/KeccakP-1600-times4-SnP.h_' "$x"/KeccakSponge-times4.c

        # get rid of some frivolous use of c++23 (but there's more, at least std::expected)
        sed -i \
        -e 's/std::to_underlying(s)/static_cast<std::size_t>(s)/' \
        -e 's/std::to_underlying(o)/static_cast<unsigned int>(o)/' \
        -e 's/= prg_type</= typename prg_type</' \
        -e 's/= leaf_hash_type</= typename leaf_hash_type</' \
        -e 's/^    bavc_type</    typename bavc_type</' \
        "$x"/parameters.hpp

        p_=`echo $underp | sed 's/\(.\)$/_\1/'`
        sed \
        -e s/%SECRETKEYBYTES%/$skbytes/g \
        -e s/%PUBLICKEYBYTES%/$pkbytes/g \
        -e s/%SIGBYTES%/$sigbytes/g \
        -e s/%PARAMSTYPE%/v3::faest_${p_}/g \
        < "$source"/api.cpp.in > "$x"/api.cpp

        sed -i '1i#include "crypto_sign.h"' "$x"/api.cpp

        sed -i 's/HashReturn/extern "C" HashReturn/' "$x"/KeccakHash-times4.h "$x"/KeccakSponge-times4.h
        sed -i 's/int rand_bytes/extern "C" int rand_bytes/' "$x"/randomness.h
        sed -i '1i#include "randombytes.h"' "$x"/randomness_randombytes.c

        sed -i '/include.*libkeccak/ {
          iextern "C" {
          a}
        }' "$x"/*
      ;;
    esac

    rm -rf "$x"/randombytes*
    rm -rf "$x"/randomness_os*

    sed -i 's_#include "\.\./_#include "_' "$x"/*
    sed -i 's_#include "avx2/_#include "_' "$x"/*
    sed -i 's_#include "aarch64/_#include "_' "$x"/*
    sed -i 's_#include "sha3/_#include "_' "$x"/*
    sed -i 's_#include "common/_#include "_' "$x"/*

    (
      echo '#define CRYPTO_SECRETKEYBYTES' $skbytes
      echo '#define CRYPTO_PUBLICKEYBYTES' $pkbytes
      echo '#define CRYPTO_BYTES' $sigbytes
    ) > "$x"/api.h

    [ "$target" = "avx2" ] && ( echo x86; echo amd64 ) > "$x/architectures"
    [ "$target" = "aarch64" ] && ( echo aarch64 ) > "$x/architectures"
  done
done

linksame crypto_sign/faest* || :

