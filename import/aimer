#!/bin/sh

supercop=.
sourcetop=import/aimer-20260825

unlinksame crypto_sign/aimer*v3new || :

for p in 128f 128s 192f 192s 256f 256s
do
  targettop="$supercop/crypto_sign/aimer${p}v3new"
  mkdir -p "$targettop"
  (
    echo ref "$sourcetop"/Reference_Implementation
    echo usekcp "$sourcetop"/Reference_Implementation
    echo clmul "$sourcetop"/Reference_Implementation
  ) |
  while read target source
  do

    x="$targettop/$target"
    rm -rf "$x"
    mkdir -p "$x"
    echo "integrating $x..."
    cp -pr "$source"/* "$x"
    cp -pr "$source"/common/* "$x"
    cp -pr "$source"/params/params-aimer-$p.h "$x"/params.h
    rm "$x"/field???.c
    case $p in
      128*) cp -pr "$source"/field128.c "$x"/field128.c ;;
      192*) cp -pr "$source"/field192.c "$x"/field192.c ;;
      256*) cp -pr "$source"/field256.c "$x"/field256.c ;;
    esac

    echo '#include "randombytes.h"' > "$x/rng.h"
    rm -rf "$x/common"
    rm -rf "$x/params"
    rm -rf "$x/test"
    rm -rf "$x/keccak2x"
    rm -rf "$x/keccak4x"
    rm -rf "$x/tests"
    rm "$x/rng.c"
    rm -f "$x"/crypto_declassify.h
    rm -f "$x"/Makefile

    rm -f "$x"/aes*

    sed -i 's/\<crypto_sign\>/crypto_sign_with_context/' "$x"/*
    sed -i 's/\<crypto_sign_open\>/crypto_sign_open_with_context/' "$x"/*
    sed -i 's/AIMER_NAMESPACE(crypto_sign)/AIMER_NAMESPACE(crypto_sign_with_context)/' "$x"/api.h
    sed -i 's/AIMER_NAMESPACE(crypto_sign_open)/AIMER_NAMESPACE(crypto_sign_open_with_context)/' "$x"/api.h
    sed -i 's/#define crypto_sign_keypair AIMER_NAMESPACE(crypto_sign_keypair)//' "$x/api.h"

    sed -i 's/uint8_t/unsigned char/g' "$x/sign.h"
    sed -i 's/uint8_t/unsigned char/g' "$x/sign.c"
    sed -i 's/uint8_t/unsigned char/g' "$x/api.h"
    sed -i 's/size_t/unsigned long long/g' "$x/sign.h"
    sed -i 's/size_t/unsigned long long/g' "$x/sign.c"
    sed -i 's/size_t/unsigned long long/g' "$x/api.h"
    sed -i 's/#include "common\/crypto_declassify.h"/#include "crypto_declassify.h"/g' "$x/sign.c"
    sed -i 's/#include "common\/rng.h"/#include "rng.h"/g' "$x/sign.c"
    sed -i 's/#include "common\/fips202.h"/#include "fips202.h"/g' "$x/hash.h"

    touch "$x/goal-constbranch"
    touch "$x/goal-constindex"

    python3 -c '
import os
import sys
import glob

def include(fn,lines,I):
  bits,ui = I
  includeline = f"#include \"crypto_{ui}{bits}.h\"\n"
  if includeline in lines: return lines

  otherincl = {}

  for bits2 in 8,16,32,64:
    for ui2 in "int","uint":
      includeline2 = f"#include \"crypto_{ui2}{bits2}.h\"\n"
      if includeline2 in lines:
        otherincl[bits2,ui2] = lines.index(includeline2)

  if any((bits2,ui2) < (bits,ui) for bits2,ui2 in otherincl):
    pos = max(otherincl[bits2,ui2] for bits2,ui2 in otherincl if (bits2,ui2) < (bits,ui))
    lines = lines[:pos+1]+[includeline]+lines[pos+1:]
  elif any((bits2,ui2) > (bits,ui) for bits2,ui2 in otherincl):
    pos = min(otherincl[bits2,ui2] for bits2,ui2 in otherincl if (bits2,ui2) > (bits,ui))
    lines = lines[:pos]+[includeline]+lines[pos:]
  elif any(L.startswith("#include") and L.strip().endswith(".h\"") for L in lines):
    pos = -1
    for i in range(len(lines)):
      if lines[i].startswith("#include") and lines[i].strip().endswith(".h\""):
        pos = i
      if lines[i].startswith("#ifdef"): break
      if lines[i].startswith("#ifndef") and pos >= 0: break
      if "{" in lines[i]: break
      if "}" in lines[i]: break
    lines = lines[:pos+1]+[includeline]+lines[pos+1:]
  else:
    # XXX: maybe should behave differently for .h files
    lines = [includeline]+lines

  return lines

x = sys.argv[1]

for fn in glob.glob(f"{x}/*.[ch]"):
  with open(fn) as f:
    lines = f.readlines()
  lines2 = []
  needincl = set()
  prepend = ""
  for line in lines:
    line = prepend+line
    prepend = ""

    line = line.replace("= -(index & 1);","= crypto_int64_bottombit_mask(index);")
    line = line.replace("= -((index >> 1) & 1);","= crypto_int64_bitmod_mask(index,1);")
    line = line.replace("= -((index >> 2) & 1);","= crypto_int64_bitmod_mask(index,2);")
    line = line.replace("= -((index >> 3) & 1);","= crypto_int64_bitmod_mask(index,3);")
    line = line.replace("= -((index >> 4) & 1);","= crypto_int64_bitmod_mask(index,4);")
    line = line.replace("= -((index >> 5) & 1);","= crypto_int64_bitmod_mask(index,5);")
    line = line.replace("= -((index >> 6) & 1);","= crypto_int64_bitmod_mask(index,6);")
    line = line.replace("= -((index >> 7) & 1);","= crypto_int64_bitmod_mask(index,7);")
    line = line.replace("= 0U - (index & 1);","= crypto_int64_bottombit_mask(index);")
    line = line.replace("= 0U - ((index >> 1) & 1);","= crypto_int64_bitmod_mask(index,1);")
    line = line.replace("= 0U - ((index >> 2) & 1);","= crypto_int64_bitmod_mask(index,2);")
    line = line.replace("= 0U - ((index >> 3) & 1);","= crypto_int64_bitmod_mask(index,3);")
    line = line.replace("= 0U - ((index >> 4) & 1);","= crypto_int64_bitmod_mask(index,4);")
    line = line.replace("= 0U - ((index >> 5) & 1);","= crypto_int64_bitmod_mask(index,5);")
    line = line.replace("= 0U - ((index >> 6) & 1);","= crypto_int64_bitmod_mask(index,6);")
    line = line.replace("= 0U - ((index >> 7) & 1);","= crypto_int64_bitmod_mask(index,7);")

    lines2.append(line)

    for bits in 8,16,32,64:
      if f"crypto_int{bits}_" in line: needincl.add((bits,"int"))
      if f"crypto_uint{bits}_" in line: needincl.add((bits,"uint"))

  if lines2 != lines:
    for I in sorted(needincl):
      lines2 = include(fn,lines2,I)
    with open(fn,"w") as f:
      for line in lines2:
        f.write(line)
' "$x"

    ( cd "$x"
      patch -p1 << 'EOF'
--- old/api.h
+++ new/api.h
@@ -9,6 +9,7 @@
 #ifndef API_H
 #define API_H

+#include "crypto_sign.h"
 #include "params.h"
 #include <stddef.h>
 #include <stdint.h>
EOF
    )

    ( cd "$x"
      patch -p1 << 'EOF'
--- old/sign.c
+++ new/sign.c
@@ -444,6 +444,12 @@
   return 0;
 }

+int crypto_sign(unsigned char *sm, unsigned long long *smlen, const unsigned char *m, unsigned long long mlen,
+                const unsigned char *sk)
+{
+  return crypto_sign_with_context(sm, smlen, m, mlen, (const unsigned char *) "", 0, sk);
+}
+
 static inline void recompute_last_share(const proof_t *proof, tape_t *tape)
 {
   gf temp = {0,};
@@ -705,3 +711,9 @@

   return 0;
 }
+
+int crypto_sign_open(unsigned char *m, unsigned long long *mlen, const unsigned char *sm, unsigned long long smlen,
+                     const unsigned char *pk)
+{
+  return crypto_sign_open_with_context(m, mlen, sm, smlen, (const unsigned char *) "", 0, pk);
+}
EOF
    )

    ( cd "$x"
      patch -p1 << 'EOF'
--- old/field_common.c
+++ new/field_common.c
@@ -1,5 +1,7 @@
 // SPDX-License-Identifier: MIT

+#include "crypto_int64.h"
+#include "crypto_declassify.h"
 #include "field.h"
 #include <stdbool.h>
 #include <stddef.h>
@@ -46,7 +48,9 @@
   {
     result |= a[i];
   }
-  return result == 0;
+  result = crypto_int64_zero_01(result);
+  crypto_declassify(&result,sizeof result);
+  return result;
 }

 void gf_copy(gf out, const gf in)
EOF
    )

    [ "$target" = clmul ] && ( echo x86; echo amd64 ) > "$x"/architectures
    [ "$target" = clmul ] && cat > "$x"/field_internal.h << 'EOF'
// SPDX-License-Identifier: MIT

#ifndef FIELD_INTERNAL_H
#define FIELD_INTERNAL_H

#include <stdint.h>
#include <immintrin.h>

static inline void poly64_mul(uint64_t *z1, uint64_t *z0,
                              uint64_t x0, uint64_t y0)
{
  __m128i x = _mm_set_epi64x(0,x0);
  __m128i y = _mm_set_epi64x(0,y0);
  __m128i z = _mm_clmulepi64_si128(x,y,0);
  *z0 = _mm_extract_epi64(z,0);
  *z1 = _mm_extract_epi64(z,1);
}

static inline void poly64_sqr(uint64_t *z1, uint64_t *z0, uint64_t x0)
{
  __m128i x = _mm_set_epi64x(0,x0);
  __m128i z = _mm_clmulepi64_si128(x,x,0);
  *z0 = _mm_extract_epi64(z,0);
  *z1 = _mm_extract_epi64(z,1);
}

#endif // FIELD_INTERNAL_H
EOF

    [ "$target" = clmul -o "$target" = usekcp ] && rm "$x"/hash.c
    [ "$target" = clmul -o "$target" = usekcp ] && rm "$x"/fips202.c
    [ "$target" = clmul -o "$target" = usekcp ] && rm "$x"/fips202.h
    [ "$target" = clmul -o "$target" = usekcp ] && cat > "$x"/hash.h << 'EOF'
// SPDX-License-Identifier: MIT

#ifndef HASH_H
#define HASH_H

#include "params.h"
#include <stddef.h>
#include <stdint.h>
#include <libkeccak.a.headers/KeccakSponge.h>

static const uint8_t HASH_PREFIX_0 = (uint8_t)AIMER_HASH_PREFIX_0;
static const uint8_t HASH_PREFIX_1 = 1;
static const uint8_t HASH_PREFIX_2 = 2;
static const uint8_t HASH_PREFIX_3 = 3;
static const uint8_t HASH_PREFIX_4 = 4;
static const uint8_t HASH_PREFIX_5 = 5;

typedef KeccakWidth1600_SpongeInstance hash_instance;

#if SECURITY_BITS == 128
#define HASH_RATE 1344
#define HASH_CAPACITY 256
#else
#define HASH_RATE 1088
#define HASH_CAPACITY 512
#endif

static inline void hash_init(hash_instance *ctx)
{
  KeccakWidth1600_SpongeInitialize(ctx,HASH_RATE,HASH_CAPACITY);
}

static inline void hash_update(hash_instance *ctx, const uint8_t *data, size_t data_len)
{
  KeccakWidth1600_SpongeAbsorb(ctx,data,data_len);
}

static inline void hash_init_prefix(hash_instance *ctx, uint8_t prefix)
{
  KeccakWidth1600_SpongeInitialize(ctx,HASH_RATE,HASH_CAPACITY);
  hash_update(ctx,&prefix,1);
}

static inline void hash_final(hash_instance *ctx)
{
  KeccakWidth1600_SpongeAbsorbLastFewBits(ctx,0x1f);
}

static inline void hash_squeeze(hash_instance *ctx, uint8_t *buffer, size_t buffer_len)
{
  KeccakWidth1600_SpongeSqueeze(ctx,buffer,buffer_len);
}

static inline void hash_ctx_release(hash_instance *ctx)
{
}

#endif
EOF

    echo 'derived from upstream aimer by supercop/import/aimer' > "$x"/implementors

  done
done

linksame crypto_sign/aimer*v3new || :

(
  cd "$supercop"
  echo fe8436d97df743e949c2b83c6a6368ad508b1e7a859b2c8d7106ea0c9eb47a7e > crypto_sign/aimer128fv3new/checksumsmall
  echo e84907a9677b93b7eca4d2de1b397c26775f1c762820559e7b5a886caab5ae3a > crypto_sign/aimer128fv3new/checksumbig
