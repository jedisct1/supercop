#!/bin/sh

supercop=.
sourcetop='import/smaugt-1.2.0' # original name SMAUG-T-1.2.0

unlinksame crypto_kem/smaugt* crypto_kem/timer* || :

for p in 1 3 5 t
do
  if [ "$p" = t ]
  then
    targettop="$supercop/crypto_kem/timerv5"
    P=T
  else
    targettop="$supercop/crypto_kem/smaugt${p}v5"
    P=$p
  fi
  echo ref "$sourcetop"/reference_implementation |
  while read target source
  do
    x="$targettop/$target"
    rm -rf "$x"
    mkdir -p "$x"
    echo "integrating $x..."
    cp "$source"/src/*.c "$x"
    cp "$source"/include/*.h "$x"
    rm "$x"/randombytes.c
    rm "$x"/randombytes.h
    sed -i '1i#include "crypto_kem.h"' "$x/kem.c"
    sed -i 's/#define SMAUGT_CONFIG_MODE SMAUGT_MODE1/#define SMAUGT_CONFIG_MODE SMAUGT_MODE'$P/ "$x"/config.h
    sed -i 's/CRYPTO_BYTES/crypto_BYTES/g' "$x"/*
    rm "$x"/api.h
    (
      echo '#include "params.h"'
      echo '#define CRYPTO_BYTES SMAUGT_crypto_BYTES'
      echo '#define CRYPTO_PUBLICKEYBYTES SMAUGT_PUBLICKEY_BYTES'
      echo '#define CRYPTO_SECRETKEYBYTES (SMAUGT_KEM_SECRETKEY_BYTES+SMAUGT_PUBLICKEY_BYTES)'
      echo '#define CRYPTO_CIPHERTEXTBYTES SMAUGT_CIPHERTEXT_BYTES'
    ) >> "$x"/api.h

    python3 -c '
import os
import sys
import glob

def include(fn,lines,I):
  bits,ui = I
  includeline = f"#include \"crypto_{ui}{bits}.h\"\n"
  if includeline in lines: return lines

  otherincl = {}

  for bits2 in 8,16,32,64:
    for ui2 in "int","uint":
      includeline2 = f"#include \"crypto_{ui2}{bits2}.h\"\n"
      if includeline2 in lines:
        otherincl[bits2,ui2] = lines.index(includeline2)

  if any((bits2,ui2) < (bits,ui) for bits2,ui2 in otherincl):
    pos = max(otherincl[bits2,ui2] for bits2,ui2 in otherincl if (bits2,ui2) < (bits,ui))
    lines = lines[:pos+1]+[includeline]+lines[pos+1:]
  elif any((bits2,ui2) > (bits,ui) for bits2,ui2 in otherincl):
    pos = min(otherincl[bits2,ui2] for bits2,ui2 in otherincl if (bits2,ui2) > (bits,ui))
    lines = lines[:pos]+[includeline]+lines[pos:]
  elif any(L.startswith("#include") and L.strip().endswith(".h\"") for L in lines):
    pos = -1
    for i in range(len(lines)):
      if lines[i].startswith("#include") and lines[i].strip().endswith(".h\""):
        pos = i
      if lines[i].startswith("#ifdef"): break
      if lines[i].startswith("#ifndef") and pos >= 0: break
      if "{" in lines[i]: break
      if "}" in lines[i]: break
    lines = lines[:pos+1]+[includeline]+lines[pos+1:]
  else:
    # XXX: maybe should behave differently for .h files
    lines = [includeline]+lines

  return lines

x = sys.argv[1]

for fn in glob.glob(f"{x}/*.[ch]"):
  with open(fn) as f:
    lines = f.readlines()
  lines2 = []
  needincl = set()
  for line in lines:
    line = line.replace("#define SMAUGT_NAMESPACE(s)","#define SMAUGT_NAMESPACE CRYPTO_NAMESPACE\n#define OLD_SMAUGT_NAMESPACE(s)")

    line = line.replace("void PACK_RING(SMAUGT_LOG_P)(uint8_t *bytes, const poly *data);","void PACK_RING(SMAUGT_LOG_P)(uint8_t bytes[SMAUGT_CTPOLY1_BYTES], const poly *data);")
    line = line.replace("void UNPACK_RING(SMAUGT_LOG_P)(poly *data, const uint8_t *bytes);","void UNPACK_RING(SMAUGT_LOG_P)(poly *data, const uint8_t bytes[SMAUGT_CTPOLY1_BYTES]);")
    line = line.replace("void PACK_RING(SMAUGT_LOG_P_PRIME)(uint8_t *bytes, const poly *data);","void PACK_RING(SMAUGT_LOG_P_PRIME)(uint8_t bytes[SMAUGT_CTPOLY2_BYTES], const poly *data);")
    line = line.replace("void UNPACK_RING(SMAUGT_LOG_P_PRIME)(poly *data, const uint8_t *bytes);","void UNPACK_RING(SMAUGT_LOG_P_PRIME)(poly *data, const uint8_t bytes[SMAUGT_CTPOLY2_BYTES]);")
    line = line.replace("void PACK_RING(SMAUGT_LOG_Q)(uint8_t *bytes, const poly *data);","void PACK_RING(SMAUGT_LOG_Q)(uint8_t bytes[SMAUGT_PKPOLY_BYTES], const poly *data);")
    line = line.replace("void UNPACK_RING(SMAUGT_LOG_Q)(poly *data, const uint8_t *bytes);","void UNPACK_RING(SMAUGT_LOG_Q)(poly *data, const uint8_t bytes[SMAUGT_PKPOLY_BYTES]);")

    line = line.replace("= (d >> (3 * j)) & 0x1;","= crypto_int64_bitmod_01(d,(3 * j));")
    line = line.replace("(((((s >> (3 * j)) & 0x1) - 1) ^ -2) | 1)","((((crypto_int64_bitmod_01(s,(3 * j))) - 1) ^ -2) | 1)")
    line = line.replace("= (t >> (2 * j + 0)) & 0x01;","= crypto_int64_bitmod_01(t,(2 * j + 0));")
    line = line.replace("= (t >> (2 * j + 1)) & 0x01;","= crypto_int64_bitmod_01(t,(2 * j + 1));")
    line = line.replace("= (d >> (4 * j)) & 0x1;","= crypto_int64_bitmod_01(d,(4 * j));")
    line = line.replace("(((((s >> (4 * j)) & 0x1) - 1) ^ -2) | 1)","((((crypto_int64_bitmod_01(s,(4 * j))) - 1) ^ -2) | 1)")
    line = line.replace("= (x[9] >> k) & 0x01;","= crypto_int64_bitmod_01(x[9],k);")
    line = line.replace("((s[0] >> k) & 0x01)","(crypto_int64_bitmod_01(s[0],k))")
    line = line.replace("((s[1] >> k) & 0x01)","(crypto_int64_bitmod_01(s[1],k))")
    line = line.replace("return (-(uint64_t)r) >> 63;","return crypto_uint64_nonzero_01(r);")
    # XXX: maybe convert delta.coeffs[i] &= 0x01

    # XXX: the following substitutions are more dangerous since they depend on types
    if fn.endswith("/hwt.c"):
      line = line.replace("= (si[i] - c0) >> 15;","= crypto_int16_negative_mask(si[i] - c0);")
      line = line.replace("while (l < t) {","for (;;) {\n            crypto_uint16 tlel = crypto_uint16_leq_mask(t,l);\n            crypto_declassify(&tlel,sizeof tlel);\n            if (tlel) break;")
      line = line.replace("#include \"hwt.h\"","#include \"hwt.h\"\n#include \"crypto_declassify.h\"")
    if fn.endswith("/poly.c"):
      line = line.replace("= r >> 15;","= crypto_int16_negative_mask(r);")
      line = line.replace("= (msg[i] >> j) & 1;","= crypto_int64_bitmod_01(msg[i],j);")
      line = line.replace(" t >>= 15;"," t = crypto_uint16_topbit_01(t);")
    lines2.append(line)

    for bits in 8,16,32,64:
      if f"crypto_int{bits}_" in line: needincl.add((bits,"int"))
      if f"crypto_uint{bits}_" in line: needincl.add((bits,"uint"))

  if lines2 != lines:
    for I in sorted(needincl):
      lines2 = include(fn,lines2,I)
    with open(fn,"w") as f:
      for line in lines2:
        f.write(line)
' "$x"

    echo 'derived from upstream smaugt by supercop/import/smaugt' > "$x"/implementors
    touch "$x"/goal-constbranch
    touch "$x"/goal-constindex
  done
done

linksame crypto_kem/smaugt* crypto_kem/timer* || :

(
  cd "$supercop"
  echo f5a70b7c8f1bd52a93235553670797755a50dd04ee68f736a5ee820747191908 > crypto_kem/smaugt1v5/checksumsmall
  echo 4733a127c43490d25f8370034d0331b9ac2167b1838fcded76029883888c46c0 > crypto_kem/smaugt1v5/checksumbig
  echo f08bb109e9ab4729975f64608ebd162534e050b3e4b10c43efe49098f4ce22eb > crypto_kem/smaugt3v5/checksumsmall
  echo 0eb0cc866b0741599b17efaf62ba5e4bd15af1eadd21cd73d7a3ba95fed68d4c > crypto_kem/smaugt3v5/checksumbig
  echo fb9091f2369b5cdb59a3e6add4f87b7cbac5865e480a373a14044f8f274f8f12 > crypto_kem/smaugt5v5/checksumsmall
  echo 5ab44286f05a3b7ad85ef4a14d7a428eb2a0b6d8fe585fccd07f9048b27cbb45 > crypto_kem/smaugt5v5/checksumbig
  echo 6e03a5a1b1fa8255645bd87bf5d47ee0ec62913952374f04993a0fe4669ce229 > crypto_kem/timerv5/checksumsmall
  echo 0dd483c7bd31132d8848291fac0e3cac71402540fac5a4febf960e8757f65124 > crypto_kem/timerv5/checksumbig
)
